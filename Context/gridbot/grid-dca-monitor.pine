//@version=6
indicator("Grid+DCA Monitor", overlay=true, max_lines_count=500)

// ── Inputs ──
grp_grid = "Grid"
atrLen   = input.int(14, "ATR Length", minval=1, group=grp_grid)
gridMult = input.float(2.0, "Grid Multiplier", minval=0.1, step=0.1, group=grp_grid)
levels   = input.int(10, "Levels Each Side", minval=1, group=grp_grid)

grp_dca = "DCA"
maxAdds  = input.int(6, "Max Adds", minval=0, group=grp_dca)
basketSk = input.float(0.5, "Basket Steps", minval=0.1, step=0.1, group=grp_dca)
escSteps = input.int(8, "Escape Steps", minval=1, group=grp_dca)

// ── Grid geometry ──
atrVal = ta.atr(atrLen)
step   = atrVal * gridMult
base   = close

// ── Grid lines ──
var line[] lowerLines = array.new_line()
var line[] upperLines = array.new_line()

if barstate.islast
    if array.size(lowerLines) > 0
        for i = 0 to array.size(lowerLines) - 1
            line.delete(array.get(lowerLines, i))
    if array.size(upperLines) > 0
        for i = 0 to array.size(upperLines) - 1
            line.delete(array.get(upperLines, i))
    array.clear(lowerLines)
    array.clear(upperLines)
    for i = 1 to levels
        lp = base - i * step
        up = base + i * step
        array.push(lowerLines, line.new(bar_index - 100, lp, bar_index + 100, lp, color=color.new(color.teal, 30), style=line.style_solid, width=2))
        array.push(upperLines, line.new(bar_index - 100, up, bar_index + 100, up, color=color.new(color.orange, 30), style=line.style_solid, width=2))

// ── DCA levels (adverse steps) ──
var line[] dcaLines = array.new_line()

if barstate.islast
    if array.size(dcaLines) > 0
        for i = 0 to array.size(dcaLines) - 1
            line.delete(array.get(dcaLines, i))
    array.clear(dcaLines)
    for i = 1 to maxAdds
        dl = base - i * step
        du = base + i * step
        array.push(dcaLines, line.new(bar_index - 100, dl, bar_index + 100, dl, color=color.new(color.red, 10), style=line.style_dashed, width=2))
        array.push(dcaLines, line.new(bar_index - 100, du, bar_index + 100, du, color=color.new(color.red, 10), style=line.style_dashed, width=2))

// ── Escape levels ──
escLo = base - escSteps * step
escHi = base + escSteps * step
plot(escLo, "Escape Low",  color=color.new(color.red, 20), linewidth=3, style=plot.style_linebr)
plot(escHi, "Escape High", color=color.new(color.red, 20), linewidth=3, style=plot.style_linebr)

// ── Basket target ──
plot(base + basketSk * step, "Basket Long",  color=color.new(color.green, 30), linewidth=2, style=plot.style_linebr)
plot(base - basketSk * step, "Basket Short", color=color.new(color.green, 30), linewidth=2, style=plot.style_linebr)

// ── Info table ──
var table t = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 20), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Grid Monitor", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "",             text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "ATR",          text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(atrVal, "#.##"),   text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "Step",         text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(step, "#.##"),     text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "Grid Range",   text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(step * levels, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "Escape Range",  text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(step * escSteps, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "Basket ±",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(basketSk * step, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 6, "DCA Adds",     text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, str.tostring(maxAdds), text_color=color.white, text_size=size.small)
