# Copy to .env.local for development. Never commit .env.local.
# Deployed builds need the same values in the EAS/host environment.

# --- cTrader Open API -------------------------------------------------------
# Client ID is public by design (it travels in the grant URL).
EXPO_PUBLIC_CTRADER_CLIENT_ID=
# Required by the mobile token exchange. This value is embedded in the app.
EXPO_PUBLIC_CTRADER_CLIENT_SECRET=

# Server copy used by /api/token on web. Kept separate from the public value
# so a web deployment can use the server-only name. If it is not set, the
# route falls back to EXPO_PUBLIC_CTRADER_CLIENT_SECRET.
CTRADER_CLIENT_SECRET=
# Optional server-side client id override (falls back to the public id).
CTRADER_CLIENT_ID=

EXPO_PUBLIC_CTRADER_ENV=demo
EXPO_PUBLIC_CTRADER_SCOPE=trading

# Native redirect override. Leave empty to use the portal-registered manual
# flow (copy the returned URL and paste it in the app). Set it to a hosted
# HTTPS bridge that deep-links to xliquid://oauth when you have one registered
# in the cTrader Open API portal.
EXPO_PUBLIC_CTRADER_REDIRECT_URI=

# Web token proxy. Defaults to the same-origin /api/token. Set this when the
# web front end is static and the proxy is hosted separately.
EXPO_PUBLIC_CTRADER_TOKEN_PROXY_URL=

# NOTE: cTrader blocks browser CORS, so web login needs a server-side token
# exchange. app.json sets web.output "server" so `expo export -p web` ships
# /api/token. A purely static host cannot complete login unless the proxy URL
# above points at a separately hosted implementation of the same POST route.

# --- Licensing --------------------------------------------------------------
# Never share. Must be present when minting/activating keys.
EXPO_PUBLIC_LICENSE_PEPPER=
